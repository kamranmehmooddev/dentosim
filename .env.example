# ── DentoSim configuration ─────────────────────────────────────────────
# Copy to .env (repo root). Web and worker both read it.

NODE_ENV=development
APP_URL=http://localhost:3000
# tenants get <slug>.<APP_BASE_DOMAIN>; custom domains CNAME to APP_URL's host
APP_BASE_DOMAIN=localhost
# 32+ random bytes: openssl rand -base64 48
APP_SECRET=change-me-change-me-change-me-change-me-change-me

# PostgreSQL — the app role must NOT be a superuser (row-level security)
DATABASE_URL=postgres://dentosim:dentosim@localhost:5432/dentosim
REDIS_URL=redis://localhost:6379

# Object storage: local (dev) or s3 (any S3-compatible store; enable SSE, CORS ExposeHeaders: ETag)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/var/lib/dentosim/storage
# S3_BUCKET=dentosim-prod
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
SIGNED_URL_TTL=300

# Email: console | resend | postmark
EMAIL_PROVIDER=console
EMAIL_FROM=DentoSim <no-reply@dentosim.cloud>
# RESEND_API_KEY=
# POSTMARK_TOKEN=

# Stripe (optional; without it billing runs in trial/limit-only mode)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CASE_PRICE_ID=price_...        (metered, tiered volume: 1–50 $5, 51–149 $4, 150+ $3.50)
# STRIPE_SETUP_FEE_PRICE_ID=price_...   (one-time $30)
# STRIPE_METER_EVENT_NAME=dentosim_case_processed
TRIAL_DAYS=14
TRIAL_CASE_LIMIT=10

# Error reporting (PHI is scrubbed before sending)
# SENTRY_DSN=

# Uploads & worker sandbox
MAX_UPLOAD_BYTES=2147483648
MAX_UPLOAD_FILES=5000
WORKER_CONCURRENCY=2
WORKER_MEMORY_MB=3072
WORKER_TIMEOUT_S=600
# WORKER_SELFCHECK=1

# Production 3D viewer (Unity WebGL build served statically, e.g. from a CDN)
# UNITY_BUILD_URL=https://cdn.example.com/dentosim-viewer/1.0.0
# DEV_VIEWER=1   # allow the Three.js development viewer in production (debug only)
