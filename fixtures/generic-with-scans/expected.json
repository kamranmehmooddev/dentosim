{
  "synthetic": true,
  "description": "Export with a wrong bite + upper/lower PLY scans in a scanner frame; registration must restore the true bite.",
  "input": "export",
  "runs": [
    {
      "name": "auto",
      "expect": {
        "status": "ready",
