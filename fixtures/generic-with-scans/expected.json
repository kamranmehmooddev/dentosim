        "noWarnings": [
          "REGISTRATION_POOR_FIT",
          "ORIENTATION_CHECK",
          "BITE_SCAN_INCONSISTENT"
        ],
        "anatomy": true,
        "bite": {
          "upperFdi": 11,
          "lowerFdi": 41,
          "distanceMm": 9.827,
          "toleranceMm": 0.1
        }
      }
    }
  ]
}
