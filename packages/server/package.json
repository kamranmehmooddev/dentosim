{
  "name": "@dentosim/server",
  "version": "0.1.0",
  "description": "DentoSim server core: database schema, tenancy, auth, storage, queue, billing, email, audit",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@dentosim/canonical": "workspace:*",
    "@dentosim/pipeline": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "bullmq": "^5.58.0",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.7.0",
    "pg": "^8.23.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.5",
    "@sentry/node": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
