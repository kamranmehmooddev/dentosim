{
  "name": "@dentosim/viewer-core",
  "version": "0.1.0",
  "description": "Engine-agnostic viewer core: TSM2 decoding, package loading/caching, playback, jaw hinge, per-tooth movement lookup",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "meshoptimizer": "^1.3.0"
  },
  "devDependencies": {
    "@dentosim/pipeline": "workspace:*",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
